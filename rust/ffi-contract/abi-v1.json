{
  "schemaVersion": 1,
  "abiEpoch": 1,
  "namespace": "agentry_core",
  "supportedTargets": ["aarch64-apple-darwin"],
  "minimumMacOSVersion": "14.0",
  "envelope": {
    "schemaVersion": 1,
    "byteOrder": "big-endian",
    "headerBytes": 16,
    "magicAscii": "AGRY",
    "maximumEnvelopeBytes": 1048576,
    "fields": [
      {"name": "magic", "offset": 0, "width": 4},
      {"name": "schemaVersion", "offset": 4, "width": 2},
      {"name": "payloadKind", "offset": 6, "width": 2},
      {"name": "flags", "offset": 8, "width": 4, "allowedValues": [0]},
      {"name": "payloadLength", "offset": 12, "width": 4}
    ],
    "payloadKinds": {"control": 1, "data": 2, "hostRequest": 3, "hostResponse": 4},
    "decodePolicy": {
      "validateBeforePayloadAllocation": true,
      "requireExactPayloadLength": true,
      "rejectTrailingBytes": true,
      "rejectTruncation": true,
      "rejectUnknownVersion": true,
      "rejectUnknownPayloadKind": true,
      "rejectNonzeroFlags": true,
      "rejectOversizeWithoutPartialDecode": true
    }
  },
  "identifiers": {
    "operationID": {"format": "lowercase-canonical-uuid"},
    "scopeID": {"format": "lowercase-canonical-uuid"},
    "requestFingerprint": {"format": "lowercase-sha256-hex", "length": 64},
    "deadline": {
      "boundaryUnit": "unix-epoch-milliseconds",
      "admissionConversion": "remaining-monotonic-duration",
      "expiredAdmission": "deadlineExpired"
    }
  },
  "operation": {
    "states": ["admitted", "running", "cancelRequested", "terminal"],
    "terminalOutcomes": ["success", "cancelled", "deadlineExceeded", "failed"],
    "sameIdSameFingerprintAndScope": "idempotent-existing-state",
    "sameIdDifferentFingerprintOrScope": "operationConflict",
    "terminalResolution": "first-terminal-wins",
    "terminalTombstoneLifetime": "runtime-lifetime"
  },
  "runtimeIdentity": {
    "fields": [
      {"name": "abiEpoch", "type": "u32", "requiredValue": 1},
      {"name": "instanceNonce", "type": "lowercase-hex", "length": 32},
      {"name": "buildFingerprint", "type": "lowercase-sha256-hex", "length": 64},
      {"name": "bindingChecksum", "type": "lowercase-sha256-hex", "length": 64}
    ],
    "requiredOnEveryRawCall": true,
    "staleBehavior": "staleRuntimeIdentity",
    "panicBehavior": {"firstCall": "internalPanic", "laterCalls": "runtimePoisoned", "unwindAcrossCAbi": false}
  },
  "admissionOutcomes": ["accepted", "duplicate"],
  "runtimeEventKinds": ["admitted", "progress", "data", "gap", "hostRequest", "payloadRejected", "terminal"],
  "ffiErrors": [
    "invalidArgument",
    "incompatibleAbi",
    "staleRuntimeIdentity",
    "runtimePoisoned",
    "runtimeStopped",
    "operationConflict",
    "deadlineExpired",
    "subscriptionNotFound",
    "queueLimitExceeded",
    "payloadTooLarge",
    "shutdownTimedOut",
    "internalPanic",
    "patternTooComplex",
    "invalidEscape",
    "unmatchedBrackets",
    "unmatchedParentheses",
    "invalidQuantifier",
    "variableLengthLookbehind",
    "invalidPattern",
    "matchLimitExceeded",
    "depthLimitExceeded",
    "heapLimitExceeded",
    "jitUnavailable",
    "searchCancelled",
    "searchInvariant",
    "codeMapInvalidRequest",
    "codeMapServiceUnavailable",
    "codeMapCancelled",
    "codeMapInvariant",
    "applyEditsInvalidParams",
    "applyEditsCancelled",
    "applyEditsInvariant",
    "inventoryScopeUnknownScope",
    "inventoryScopeUnknownRoot",
    "inventoryScopeLifetimeMismatch",
    "inventoryScopeNoPublishedGeneration",
    "inventoryScopeBulkLoadUnknown",
    "inventoryScopeBulkLoadAlreadyTerminal",
    "inventoryScopeBulkLoadRootMismatch",
    "inventoryHandleInvalidated",
    "inventoryScopeInvalidRequest"
  ],
  "searchLeaf": {
    "additiveInAbiEpoch": 1,
    "coordinates": "utf8-byte-half-open",
    "lineNumbers": "zero-based",
    "typedDtos": true,
    "synchronousExports": true,
    "batchExports": {
      "structuredCompatibility": "searchRegexBatch",
      "productionCompactV1": "searchRegexBatchCompactV1",
      "canonicalMatcherShared": true
    },
    "compactBatchV1": {
      "subjectAlignment": "input-index",
      "lineRangeWords": {"stride": 2, "fields": ["start", "end"]},
      "hitWords": {
        "stride": 6,
        "fields": ["lineNumber", "selectedLineIndex", "matchStart", "matchEnd", "contextBeforeCount", "contextAfterCount"]
      },
      "selectedLines": "ordered-deduplicated-hit-and-context-union",
      "selectedLineIndex": "subject-relative",
      "collectionCap": "hit-payload-only",
      "matchingLineCount": "uncapped"
    },
    "runtimeIdentityRequired": true,
    "requestScopedCancellation": {
      "object": "LeafCancellation",
      "operations": ["create", "cancel", "close"],
      "idempotentCancelAndClose": true
    },
    "contentCancellation": "searchCancelled",
    "pathCancellation": "ordered-partial-result",
    "malformedRangeBehavior": "searchInvariant",
    "productFallback": "none"
  },
  "codeMapCompactV1": {
    "additiveInAbiEpoch": 1,
    "contractVersion": 1,
    "export": "codeMapExtractBatchCompactV1",
    "coordinates": "utf8-byte-half-open",
    "subjectAlignment": "input-index",
    "languageIDs": {
      "swift": 1,
      "javascript": 2,
      "cSharp": 3,
      "python": 4,
      "c": 5,
      "rust": 6,
      "cpp": 7,
      "go": 8,
      "java": 9,
      "typeScript": 10,
      "tsx": 11,
      "php": 12,
      "ruby": 13
    },
    "outcomeTags": {
      "ready": 0,
      "readyNoSymbols": 1,
      "oversizeUtf8Bytes": 2,
      "oversizeUtf16Units": 3,
      "oversizeLines": 4,
      "decodeFailedUndecodable": 5,
      "parseFailedNilTree": 6,
      "parseFailedNilRoot": 7
    },
    "tables": {
      "stringRangeWords": {"stride": 2},
      "stringIndexWords": {"stride": 1},
      "classWords": {"stride": 5},
      "interfaceWords": {"stride": 5},
      "aliasWords": {"stride": 2},
      "functionWords": {"stride": 6},
      "parameterWords": {"stride": 3},
      "propertyWords": {"stride": 2},
      "enumWords": {"stride": 3},
      "variableWords": {"stride": 3}
    },
    "runtimeIdentityRequired": true,
    "requestScopedCancellation": "LeafCancellation",
    "productFallback": "none"
  },
  "applyEditsCompactV1": {
    "additiveInAbiEpoch": 1,
    "contractVersion": 1,
    "export": "applyEditsBatchCompactV1",
    "coordinates": "utf8-byte-half-open",
    "subjectAlignment": "input-index",
    "modeTags": {"rewrite": 0, "single": 1, "batch": 2},
    "resultStatusTags": {"success": 0, "partial": 1, "failed": 2},
    "operationOutcomeTags": {"success": 0, "failed": 1},
    "diffLineTags": {"context": 0, "addition": 1, "removal": 2},
    "optionalWord": "u64::MAX",
    "tables": {
      "stringRangeWords": {"stride": 2},
      "byteEditWords": {"stride": 4},
      "chunkWords": {"stride": 8, "v1Flags": [0]},
      "diffLineWords": {"stride": 2},
      "outcomeWords": {"stride": 3}
    },
    "runtimeIdentityRequired": true,
    "requestScopedCancellation": "LeafCancellation",
    "productFallback": "none"
  },
  "inventoryScopeV1": {
    "additiveInAbiEpoch": 1,
    "abiEpochDecision": "no bump: additive-only, no existing export's signature changed; same precedent as cc22c7e1/a756190d/2803d3d9 (P3-3/P3-4), each of which added CoreRuntime exports without bumping abiEpoch",
    "contractDoc": "docs/architecture/rust-inventory-scope-v1.md",
    "designDoc": "docs/designs/p4-workspace-inventory-authority-v2-2026-08-22.md",
    "wireContractVersion": 1,
    "messageKinds": {
      "bulkChunk": 1,
      "deltaEvent": 2,
      "resolveRequest": 3,
      "lookupRequest": 4,
      "factBlock": 5,
      "queryRequest": 6,
      "queryResponse": 7
    },
    "tables": {
      "stringRangeWords": {"stride": 2},
      "recordWords": {"stride": 14},
      "factRowWords": {"stride": 18},
      "candidateRowWords": {"stride": 11}
    },
    "optionalWord": "u64::MAX",
    "limits": {
      "maxBlobBytes": 67108864,
      "maxStringLenBytes": 65536,
      "maxWordsPerSection": 8388608,
      "maxRowsPerCall": 200000,
      "maxIdsPerCall": 50000,
      "maxPathsPerCall": 50000
    },
    "handleBasedReads": ["inventorySnapshotPage", "inventoryLookupPaths", "inventoryQuery"],
    "handleInvalidation": "typed CoreError (inventoryHandleInvalidated), not a panic -- contract §4 layer 3",
    "liveTruthReads": {
      "inventoryResolveRecords": "scope+root, optional expectedCatalogGeneration staleness guard",
      "inventoryLookupPaths": "handle selects the root; facts still read against the scope's live identity maps, not the handle's frozen generation -- see InventoryScope::lookup_paths's doc comment"
    },
    "swiftMirrorFingerprint": {
      "mechanism": "SHA-256 of a canonical ASCII descriptor string both sides independently construct (NOT std::hash::Hash/DefaultHasher, which is unstable across Rust releases)",
      "rustSource": "agentry_runtime::inventory_scope::wire::fingerprint",
      "swiftTest": "Tests/AgentryCoreBridgeTests/InventoryScopeWireFingerprintTests.swift"
    },
    "runtimeIdentityRequired": true,
    "productFallback": "none"
  },
  "subscription": {
    "capacityEvents": 256,
    "capacityBytes": 1048576,
    "reservedTerminalSlots": 1,
    "reservedTerminalControlBytes": 4096,
    "defaultDrainMaxItems": 64,
    "defaultDrainMaxBytes": 262144,
    "hardDrainMaxItems": 256,
    "hardDrainMaxBytes": 1048576,
    "minimumDrainMaxBytes": 4096,
    "delivery": "exactly-once-dequeue",
    "dataOverflow": "coalesced-gap-event",
    "oversize": "compact-payloadRejected-event",
    "terminalMayEvictOldestData": true
  },
  "agentClaudeV1": {
    "additiveInAbiEpoch": 1,
    "abiEpochDecision": "no bump at P6-6 landing (additive-only, no existing export's signature changed; same precedent as cc22c7e1/a756190d/2803d3d9/inventoryScopeV1). P6-7 amendment: agentApplyModelAndEffort's return type changed from throws-only (void) to -> AgentClaudeFlagSettingsReceiptV1, a genuine existing-export signature change, not additive -- still no bump, because Swift bindings and the Rust FFI archive are always regenerated and rebuilt together from the same commit (never independently versioned/shipped), and buildFingerprint/bindingChecksum (recomputed and validated via staleRuntimeIdentity on every raw call) already catch any binding/archive staleness at a finer grain than abiEpoch guards; abiEpoch protects the coarse envelope/wire-format layer (header layout, payload kinds), unchanged here. See rust/ffi-contract/exports.txt's matching comment.",
    "contractDoc": "docs/architecture/rust-agent-claude-v1.md",
    "designDoc": "docs/designs/p6-claude-vertical-2026-08-23.md",
    "scope": "claudeCode provider kind only; GLM/Kimi/custom-Claude-compatible are P6-9",
    "exports": [
      "agentOpenScope", "agentStartOrResume", "agentSendUserMessage", "agentInterruptTurn",
      "agentRespondPermission", "agentApplyModelAndEffort", "agentShutdown"
    ],
    "eventEnvelope": {
      "mechanism": "a versioned, batched JSON object per event ({\"v\":1,\"kind\":...}), crossing on the existing generic openSubscription/tryDrain surface -- no per-domain subscribe export, same precedent as inventoryScopeV1",
      "rustSource": "agentry_runtime::agent_claude::event::AgentClaudeEvent",
      "lossClassification": "contract §7.1 -- lossless/coalescible/droppable per kind, with sessionStateChanged's is_idle field (not the kind alone) selecting lossless vs coalescible"
    },
    "interruptOutcomes": ["acknowledged", "noTurnInFlight", "staleGeneration", "timedOut", "failed"],
    "inv_p6_1": "no export accepts a single protocol line; the sole per-line export (agent_claude_decode_line_debug_v1, P6-5) is DEBUG-feature-gated and never a UniFFI export by construction -- asserted against exports.txt by rust/crates/ffi/tests/agent_claude_exports_contract.rs",
    "sessionPersistence": "unchanged -- AgentSession/AgentSessionIndex stay Swift-owned for the whole vertical (design §6); Rust holds live-run state in memory only",
    "runtimeIdentityRequired": true,
    "productFallback": "none"
  },
  "fixtureManifest": "rust/benchmarks/fixtures/v1/manifest.json",
  "sloRegistry": "rust/benchmarks/slo-v1.json",
  "exportsInventory": "rust/ffi-contract/exports.txt"
}
