# Swift Package Manager / build artifacts
.build/
.swiftpm/
Package.resolved.backup
# Defensive fallback if Cargo is invoked without rust/.cargo/config.toml.
rust/target/

# Xcode / Apple build products
DerivedData/
build/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcuserstate

# Packaged app / archives / symbols
*.app/
# Sparkle ships this helper app inside its vendored release framework.
!Vendor/Sparkle/Sparkle.xcframework/macos-arm64_x86_64/Sparkle.framework/Versions/B/Updater.app/
!Vendor/Sparkle/Sparkle.xcframework/macos-arm64_x86_64/Sparkle.framework/Versions/B/Updater.app/**
*.dSYM/
# Sparkle's vendored xcframework Info.plist declares DebugSymbolsPath=dSYMs.
# SwiftPM refuses to plan a build when that directory is absent, so the tracked
# xcframework must ship its debug symbols instead of having them swallowed by
# the *.dSYM/ rule above.
!Vendor/Sparkle/Sparkle.xcframework/macos-arm64_x86_64/dSYMs/*.dSYM/
!Vendor/Sparkle/Sparkle.xcframework/macos-arm64_x86_64/dSYMs/**
*.dSYM.zip
*.ipa
*.xcarchive
*.pkg
*.dmg
dist/

# Logs and transient diagnostics
*.log
*.trace
*.xcresult/
*.profraw

# Agent-authored working documents
docs/analysis/
docs/designs/
docs/references/
docs/reviews/
docs/plans/*
!docs/plans/test-coverage-value-audit-2026-05-29.md

# Python cache artifacts
__pycache__/
*.pyc

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
Icon


# Editor / local env
.env
.env.*
!.env.example
.vscode/
.idea/
.claude/settings.local.json
